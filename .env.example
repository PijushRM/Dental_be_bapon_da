MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=dental
JWT_SECRET=change-me-to-a-random-string-of-32-plus-chars

# Comma-separated allowed browser origins for the API (use * for any). Unset = any origin in dev, none in production.
CORS_ORIGINS=http://localhost:5173

# Largest file upload (record files and profile photo), in MB. Keep it the same as
# MAX_UPLOAD_MB in the app's .env. Optional: defaults to 1.
MAX_UPLOAD_MB=1
